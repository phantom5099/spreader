# ===== 私有文档 =====
docs-hide
docs-ignore

# ===== 构建产物 =====
/bin/
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
# tsc -b 的增量编译缓存（含绝对路径，入库会导致换机器时编译行为不一致）
*.tsbuildinfo

# ===== Go =====
/vendor/
*.prof
*.cover
coverage.txt
coverage.html

# ===== Web 前端（web/ 是独立的 Vite 项目）=====
web/node_modules/
web/dist/
web/shots/
web/.vite/

# ===== 环境变量与密钥 =====
.env
.env.local
.env.*.local
*.pem
*.key
*.crt
!deploy/**/*.example

# ===== 本地数据卷 =====
/data/
.deploy-data/
deploy/compose/data/

# ===== IDE 与编辑器 =====
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ===== 工具与临时文件 =====
.workbuddy/
tmp/
.tmp/
*.log
!deploy/**/*.log.example

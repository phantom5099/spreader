# 本地开发环境变量示例：`make env` 复制为 .env，`make run` / `make loadtest` 会自动加载。
# 只列进程真正读取的变量；其余配置项（监听地址、Redis 地址、限额、通道选择）在 app/configs/*.yaml。

# --- 运行环境 ---
APP_ENV=dev                          # production 会关闭 mock 第三方（双闸之一），本地勿改
# SERVER_CONF=                       # 配置文件路径；make run / make loadtest 已用 -conf 传入

# --- 数据库（对应 app/configs 的 database.dsn_env）---
SERVER_PG_DSN=postgres://spreader:spreader@127.0.0.1:15432/spreader?sslmode=disable

# --- 进程凭据（缺失即启动失败，绝不静默用空密钥）---
SERVER_JWT_SECRET=dev-only-jwt-secret-32bytes-min
SERVER_OTP_PEPPER=dev-only-otp-pepper
SERVER_ARGON_PEPPER=dev-only-argon-pepper

# --- 邮件通道：server.yaml 的 login.email 走 smtp；留空则该通道不注册（降级 console）---
SMTP_USERNAME=
SMTP_AUTH_CODE=

# --- 云短信：server.yaml 的 login.phone 降级通道；留空则该通道不注册 ---
SMS_SECRET_ID=
SMS_SECRET_KEY=
SMS_SDK_APP_ID=
SMS_TEMPLATE_ID=

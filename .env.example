# --- 运行环境 ---
APP_ENV=dev
APP_DEBUG=true
# 服务监听（各服务可覆盖）
HTTP_ADDR=0.0.0.0:8000
GRPC_ADDR=0.0.0.0:9000

# 开发环境走 docker-compose 暴露的本地端口
DATABASE_DSN=postgres://spreader:spreader@127.0.0.1:15432/spreader?sslmode=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=5

# --- Redis（架构文档 §3.2.2）---
REDIS_ADDR=127.0.0.1:16379
REDIS_PASSWORD=
REDIS_DB=0

# --- Kafka（KRaft 模式，架构文档 §3.2.3）---
KAFKA_BROKERS=127.0.0.1:19092
KAFKA_CONSUMER_GROUP=spreader-dev

# --- 对象存储（S3 兼容，开发用 MinIO，架构文档 §3.2.4）---
S3_ENDPOINT=http://127.0.0.1:19000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=spreader-media
S3_USE_SSL=false

# --- Elasticsearch（架构文档 §3.2.5）---
ELASTICSEARCH_ADDR=http://127.0.0.1:19200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# --- 可观测性（架构文档 §3.6.9）---
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:14317
OTEL_SERVICE_NAME=spreader-dev
OTEL_TRACES_SAMPLER_ARG=1.0

# --- 服务间认证（开发环境关闭 mTLS，架构文档 §3.6.10）---
MTLS_ENABLED=false

# --- 第三方（开发环境可留空，走 Mock）---
WECHAT_APP_ID=
WECHAT_APP_SECRET=
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
PUSH_APNS_KEY_ID=
PUSH_APNS_TEAM_ID=
